@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Theatre Company</h1>
    <p>Your premier destination for theatrical performances and entertainment.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Upcoming Shows</h2>
        <p>Check out our exciting lineup of upcoming performances.</p>
    </div>
    <div class="col-md-4">
        <h2>Book Tickets</h2>
        <p>Reserve your seats for our shows.</p>
    </div>
    <div class="col-md-4">
        <h2>About Us</h2>
        <p>Learn more about our theatre company and our mission.</p>
    </div>
</div>

<!-- Top right info box-->
<div id="content">



    <div class="info-box">
        <p>
            <i class="fa fa-phone-square"></i>
            0333 009 6690
            <span class="divider-line"></span>

            <i class="fa fa-envelope-square"></i>
            info@TheatreCompany.com
        </p>
    </div>

    <!-- scroller-section
        ================================================== -->
    <section class="scroller-section">

        <div class="scroller-box owl-scroller">
            <div class="owl-carousel owl-theme" data-num="3">

                <div class="item">
                    <div class="scroller-post">
                        <div class="image-holder">
                            <img src="~/images/s1.jpg" alt="s1">
                        </div>
                        <div class="hover-box">
                            <span>01</span>
                            <a class="cat-link" href="portfolio.html">Announcements</a>
                            <h3><a href="#">Keep an eye on our news!</a></h3>
                        </div>
                    </div>
                </div>

                <div class="item">
                    <div class="scroller-post">
                        <div class="image-holder">
                            <img src="~/images/s2.jpg" alt="s2">
                        </div>
                        <div class="hover-box">
                            <span>02</span>
                            <a class="cat-link" href="portfolio.html">Movie Reviews</a>
                            <h3><a href="#">Reviews by our staff!</a></h3>
                        </div>
                    </div>
                </div>

                <div class="item">
                    <div class="scroller-post">
                        <div class="image-holder">
                            <img src="~/images/s3.jpg" alt="s3">
                        </div>
                        <div class="hover-box">
                            <span>03</span>
                            <a class="cat-link" href="portfolio.html">About</a>
                            <h3><a href="#">Find out more about us</a></h3>
                        </div>
                    </div>
                </div>

                <div class="item">
                    <div class="scroller-post">
                        <div class="image-holder">
                            <img src="~/images/s4.jpg" alt="s1">
                        </div>
                        <div class="hover-box">
                            <span>04</span>
                            <a class="cat-link" href="portfolio.html">Location</a>
                            <h3><a href="#">Where to find us</a></h3>
                        </div>
                    </div>
                </div>

                <div class="item">
                    <div class="scroller-post">
                        <div class="image-holder">
                            <img src="~/images/s6.jpg" alt="s2">
                        </div>
                        <div class="hover-box">
                            <span>05</span>
                            <a class="cat-link" href="portfolio.html">Login</a>
                            <h3><a href="#">Members Only in here!</a></h3>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <p class="fixed-notifier">
            Slide by scroll
            <span></span>
        </p>

    </section>
    <!-- End scroller-section -->

</div>
