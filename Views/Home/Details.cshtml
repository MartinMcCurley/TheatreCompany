@model TheatreCompany.Models.Post

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="card">
        <div class="card-body">
            <h1 class="card-title">@Model.Title</h1>
            <div class="text-muted mb-3">
                Posted by @Model.User.Email on @Model.CreatedAt.ToString("MMMM dd, yyyy")
                in @Model.Category.Name
            </div>
            
            <div class="card-text">
                @Html.Raw(Model.Body)
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="mt-4">
                    <h4>Add a Comment</h4>
                    <form asp-controller="Home" asp-action="AddComment" method="post">
                        <input type="hidden" name="PostId" value="@Model.Id" />
                        <div class="form-group">
                            <textarea name="Body" class="form-control" rows="3" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary mt-2">Submit Comment</button>
                    </form>
                </div>
            }

            @if (Model.Comments != null && Model.Comments.Any())
            {
                <div class="mt-4">
                    <h4>Comments</h4>
                    @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                    {
                        <div class="card mb-2">
                            <div class="card-body">
                                <p class="card-text">@comment.Body</p>
                                <small class="text-muted">
                                    By @comment.User.Email on @comment.CreatedAt.ToString("MMMM dd, yyyy")
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
