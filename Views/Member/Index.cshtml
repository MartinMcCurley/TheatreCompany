@model IEnumerable<TheatreCompany.Models.Post>

@{
    ViewData["Title"] = "My Posts";
}

<div class="container mt-4">
    <h2>My Posts</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Post</a>
    </p>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Title)</h5>
                        <p class="card-text">@Html.Raw(item.Body.Length > 200 ? item.Body.Substring(0, 200) + "..." : item.Body)</p>
                        <p class="text-muted">
                            Category: @Html.DisplayFor(modelItem => item.Category.Name)<br />
                            Posted: @item.CreatedAt.ToString("MMMM dd, yyyy")
                        </p>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
