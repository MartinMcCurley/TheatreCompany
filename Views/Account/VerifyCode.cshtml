@model TheatreCompany.Models.VerifyCodeViewModel
@{
    ViewData["Title"] = "Verify";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <div class="row">
        <div class="col-md-8">
            <form asp-controller="Account" asp-action="VerifyCode" asp-route-returnurl="@Model.ReturnUrl" method="post" class="form-horizontal">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="Provider" type="hidden" />
                <input asp-for="RememberMe" type="hidden" />
                <h4>Enter verification code</h4>
                <hr />
                <div class="form-group">
                    <label asp-for="Code" class="col-md-2 control-label">@ViewData["Status"]</label>
                    <div class="col-md-10">
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <div class="checkbox">
                            <label>
                                <input asp-for="RememberBrowser" />
                                @Html.DisplayNameFor(m => m.RememberBrowser)
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
