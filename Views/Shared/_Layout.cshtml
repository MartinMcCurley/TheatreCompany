<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - Theatre Company</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- Define required fonts-->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Rubik:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">

    <!-- Base styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Theme styles -->
    <environment include="Development">
        <link rel="stylesheet" href="~/css/font-awesome.min.css" />
        <link rel="stylesheet" href="~/css/line-awesome.min.css" />
        <link rel="stylesheet" href="~/css/magnific-popup.css" />
        <link rel="stylesheet" href="~/css/owl.carousel.css" />
        <link rel="stylesheet" href="~/css/owl.theme.css" />
        <link rel="stylesheet" href="~/css/jquery-ui.min.css" />
        <link rel="stylesheet" href="~/css/jquery.bxslider.css" />
        <link rel="stylesheet" href="~/css/flexslider.css" />
        <link rel="stylesheet" href="~/css/settings.css" />
        <link rel="stylesheet" href="~/css/layers.css" />
        <link rel="stylesheet" href="~/css/navigation.css" />
        <link rel="stylesheet" href="~/css/style.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    </environment>

    <!-- Google Maps Script - Preload -->
    <link rel="preconnect" href="https://maps.googleapis.com">
    <link rel="preconnect" href="https://maps.gstatic.com">
    <script>
        function initMap() {
            // This function will be called when the maps script loads
            if (window.mapsCallback) {
                window.mapsCallback();
            }
        }
    </script>
    <script async
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCiqrIen8rWQrvJsu-7f4rOta0fmI5r2SI&callback=initMap">
    </script>

    <link rel="stylesheet" type="text/css" href="~/css/custom.css">
</head>
<body>
    <div id="ip-container" class="ip-container">
        <!-- initial loader -->
        <div class="ip-header">
            <p class="ip-logo">
                <img src="~/images/logo-image.png" alt="">
            </p>

            <div class="ip-loader">
                <svg class="ip-inner" width="100px" height="100px" viewBox="0 0 80 80">
                    <path class="ip-loader-circlebg" d="M40,10C57.351,10,71,23.649,71,40.5S57.351,71,40.5,71 S10,57.351,10,40.5S23.649,10,40.5,10z" />
                    <path id="ip-loader-circle" class="ip-loader-circle" d="M40,10C57.351,10,71,23.649,71,40.5S57.351,71,40.5,71 S10,57.351,10,40.5S23.649,10,40.5,10z" />
                </svg>
            </div>
        </div>

        <!-- Container -->
        <div id="container">
            <!-- Header and sidebar -->
            <header class="clearfix">
                <div class="logo">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo-image.png" alt="">
                    </a>
                </div>
                <div class="header-line">
                    <a class="open-menu-toggle" href="#">
                        <span></span>
                        <span></span>
                        <span></span>
                    </a>
                    <!-- Side bar with social icons -->
                    <div class="social-line">
                        <ul class="social-list">
                            <li>
                                <a href="https://www.facebook.com/kingsandtheatreroyalglasgow/"><i class="fab fa-facebook-square"></i></a>
                            </li>
                            <li>
                                <a href="https://www.instagram.com/kingsandroyalglasgow/"><i class="fab fa-instagram"></i></a>
                            </li>
                            <li>
                                <a href="https://twitter.com/KingsandRoyal"><i class="fab fa-twitter-square"></i></a>
                            </li>
                        </ul>
                    </div>
                    <div class="copyright-line">
                        <p>© Theatre Company @DateTime.Now.Year</p>
                    </div>
                </div>

                <!-- Popout menu -->
                <nav class="nav-menu-box">
                    <ul class="navigation-menu-list">
                        <li>
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Contact">Location</a>
                        </li>
                        <li>
                            <a asp-controller="Posts" asp-action="Index">Blog</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Member"))
                            {
                                <li class="menu-item-has-children">
                                    <a href="#"><span><em>Member Options</em></span></a>
                                    <ul class="sub-menu">
                                        <li><a asp-controller="User" asp-action="Index">My Details</a></li>
                                        <li><a asp-controller="Comments" asp-action="Index">My Comments</a></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="LogOff" method="post">
                                                <button type="submit" class="nav-link btn btn-link">Log Off</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                            }
                        }
                        else
                        {
                            <li>
                                <a asp-area="Identity" asp-page="/Account/Login">Join/Login</a>
                            </li>
                        }
                    </ul>
                </nav>
            </header>
        </div>

        @RenderBody()
    </div>

    <!-- Base scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Theme scripts -->
    <environment include="Development">
        <script src="~/js/jquery-ui.min.js"></script>
        <script src="~/js/jquery.nouislider.min.js"></script>
        <script src="~/js/jquery.magnific-popup.min.js"></script>
        <script src="~/js/jquery.imagesloaded.min.js"></script>
        <script src="~/js/jquery.isotope.min.js"></script>
        <script src="~/js/jquery.bxslider.min.js"></script>
        <script src="~/js/jquery.flexslider.js"></script>
        <script src="~/js/owl.carousel.min.js"></script>
        <script src="~/js/pathLoader.js"></script>
        <script src="~/js/jquery.themepunch.tools.min.js"></script>
        <script src="~/js/jquery.themepunch.revolution.min.js"></script>
        <script src="~/js/jquery.appear.js"></script>
        <script src="~/js/jquery.countTo.js"></script>
        <script src="~/js/gmap3.min.js"></script>
        <script src="~/js/script.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/site.min.js" asp-append-version="true"></script>
    </environment>

    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Maps initialization -->
    <script src="~/js/maps.js"></script>
</body>
</html>