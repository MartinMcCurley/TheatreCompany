@model TheatreCompany.Models.AddPhoneNumberViewModel
@{
    ViewData["Title"] = "Add Phone Number";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-controller="Manage" asp-action="AddPhoneNumber" method="post" class="form-horizontal">
        <h4>Add a phone number.</h4>
        <hr />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Number" class="col-md-2 control-label"></label>
            <div class="col-md-10">
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

