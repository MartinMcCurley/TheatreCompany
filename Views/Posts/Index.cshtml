@model IEnumerable<TheatreCompany.Models.Post>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Posts";
    var isAdmin = User.IsInRole("Admin");
    var isMember = User.IsInRole("Member");
    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value ?? string.Empty;
}

<div id="content">

    <!-- page-banner-section
        ================================================== -->
    <section class="page-banner-section">
        <div class="container">
            <h1>Announcements</h1>
            <p>Welcome to our posts</p>
        </div>
        <div class="info-box">
            <p>
                <i class="fa fa-phone-square"></i>
                0333 009 6690
                <span class="divider-line"></span>

                <i class="fa fa-envelope-square"></i>
                info@TheatreCompany.com
            </p>
        </div>
    </section>
    <!-- End page-banner section -->
    <!-- Search By Category Function -->
    @using (Html.BeginForm())
    {
        <p>
            Find posts by category: @Html.TextBox("SearchString")

            <input type="submit" value="Search" />
        </p>
    }
    @if (isMember || isAdmin)
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </p>
    }

    <br />
    <hr />


    <!-- blog-section
        ================================================== -->
    <section class="blog-section">
        <div class="container">
            <div class="blog-box">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Title)</th>
                                <th>@Html.DisplayNameFor(model => model.Body)</th>
                                <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                                <th>@Html.DisplayNameFor(model => model.Category)</th>
                                <th>@Html.DisplayNameFor(model => model.User)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Body)</td>
                                    <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.User.Email)</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                                        @if (isAdmin || (isMember && item.UserId == User.Identity?.Name))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <ul class="pagination-list">
                <li><a href="#" class="active">01</a></li>
                <li><a href="#">02</a></li>
                <li><a href="#">03</a></li>
            </ul>
        </div>
    </section>
    <!-- End blog-section -->
</div>
